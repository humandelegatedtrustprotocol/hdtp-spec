{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hdtp:schema:draft",
  "title": "HDTP draft: the JSON objects of the wire",
  "description": "Generated by schema/gen.mjs from hdtp-identity's contract/contract.json (spec 1.0.0); do not edit. The objects: Envelope, SigningRequest, ExportManifest, ContactRow, ThreadRow, MessageRow.",
  "$defs": {
    "Attachment": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "filename": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5242880
        }
      },
      "required": [
        "file",
        "filename",
        "mime",
        "size"
      ],
      "additionalProperties": false
    },
    "B64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$",
      "description": "Bytes, as base64url without padding, in exactly this alphabet. Every answer spells them this way, and every wire object of the specification is read this strictly: an envelope's members, an export's certificates, a signing request. A library argument outside those objects is also read with padding or the standard alphabet, and never with whitespace (CONTRACT §0)."
    },
    "CertDer": {
      "$ref": "#/$defs/B64url",
      "description": "One X.509 certificate, DER."
    },
    "ContactRow": {
      "type": "object",
      "description": "One row of contacts.csv (SPEC §9.2), as JSON: the permissions as lists, was_active a boolean, an empty leaf or root_cert null.",
      "properties": {
        "root": {
          "$ref": "#/$defs/Fingerprint"
        },
        "endpoint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "blocked",
            "pending_out"
          ]
        },
        "was_active": {
          "type": "boolean"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "their_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "leaf": {
          "oneOf": [
            {
              "$ref": "#/$defs/CertDer"
            },
            {
              "type": "null"
            }
          ]
        },
        "root_cert": {
          "oneOf": [
            {
              "$ref": "#/$defs/CertDer"
            },
            {
              "type": "null"
            }
          ]
        },
        "added": {
          "$ref": "#/$defs/InstantIn"
        }
      },
      "required": [
        "root",
        "endpoint",
        "name",
        "display_name",
        "status",
        "was_active",
        "permissions",
        "their_permissions",
        "added"
      ],
      "additionalProperties": false
    },
    "Envelope": {
      "type": "object",
      "properties": {
        "protected": {
          "$ref": "#/$defs/B64url"
        },
        "enc": {
          "$ref": "#/$defs/B64url"
        },
        "ct": {
          "$ref": "#/$defs/B64url"
        },
        "sig": {
          "$ref": "#/$defs/B64url"
        }
      },
      "required": [
        "protected",
        "enc",
        "ct",
        "sig"
      ],
      "additionalProperties": false,
      "description": "A sealed envelope: its four members (SPEC §13.1)."
    },
    "ExportManifest": {
      "type": "object",
      "description": "manifest.json (SPEC §9.2), exactly these members.",
      "properties": {
        "hdtp_export": {
          "const": 1
        },
        "owner": {
          "$ref": "#/$defs/Fingerprint"
        },
        "owner_name": {
          "type": "string"
        },
        "exported_at": {
          "$ref": "#/$defs/InstantIn"
        },
        "tool": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "properties": {
            "contacts": {
              "type": "integer",
              "minimum": 0
            },
            "threads": {
              "type": "integer",
              "minimum": 0
            },
            "messages": {
              "type": "integer",
              "minimum": 0
            },
            "media": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "contacts",
            "threads",
            "messages",
            "media"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "object",
          "properties": {
            "contacts.csv": {
              "$ref": "#/$defs/Sha256Hex"
            },
            "threads.csv": {
              "$ref": "#/$defs/Sha256Hex"
            },
            "messages.jsonl": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "additionalProperties": false,
          "description": "The text members to the sha256 of their bytes. Never a media member: each is bound by its name, the sha256 of its bytes, and counted by counts.media."
        }
      },
      "required": [
        "hdtp_export",
        "owner",
        "owner_name",
        "exported_at",
        "tool",
        "counts",
        "files"
      ],
      "additionalProperties": false
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$",
      "description": "`\"sha256:\" + b64url(SHA-256(SPKI))`."
    },
    "InstantIn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "An RFC 3339 UTC instant as an argument, in the one grammar every port reads: upper-case T and Z, no offset, `.` alone before a fraction of a second, which is allowed and DROPPED, because the boundary is whole seconds."
    },
    "MessageRow": {
      "type": "object",
      "description": "One line of messages.jsonl (SPEC §9.2): at most one attachment, and a message with one has an empty body.",
      "properties": {
        "id": {
          "type": "string"
        },
        "thread": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "msg_id": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "in",
            "out"
          ]
        },
        "sender": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "time": {
          "$ref": "#/$defs/InstantIn"
        },
        "body": {
          "type": "string"
        },
        "reply_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "delivered",
            "queued",
            "failed",
            "read"
          ]
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "maxItems": 1
        }
      },
      "required": [
        "id",
        "thread",
        "contact",
        "msg_id",
        "direction",
        "sender",
        "time",
        "body",
        "status",
        "attachments"
      ],
      "additionalProperties": false
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "A sha256, lowercase hex."
    },
    "SigningRequest": {
      "type": "object",
      "description": "A host's signing request (SPEC §9.1), the members of its form as the form carries them: every one a string. Bounds are bytes, and characters (Unicode scalar values) for `recipient`; the whole body is bounded by the wallet's host.",
      "properties": {
        "csr": {
          "type": "string",
          "maxLength": 4096,
          "description": "base64url PKCS #10: the recipient's key and the endpoint."
        },
        "purpose": {
          "enum": [
            "renew",
            "move"
          ]
        },
        "expect_root": {
          "$ref": "#/$defs/Fingerprint"
        },
        "root_cert": {
          "type": "string",
          "maxLength": 4096,
          "description": "base64url DER of the root, if the host holds it."
        },
        "redirect": {
          "type": "string",
          "maxLength": 2048,
          "description": "Where the answer goes: https, or http to a loopback host; no userinfo, no fragment."
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "32 random bytes, base64url, echoed back."
        },
        "recipient": {
          "type": "string",
          "maxLength": 200,
          "description": "What the host calls itself: shown as its claim, never trusted."
        },
        "valid_days": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]?|[12][0-9]{2}|3[0-8][0-9]|39[0-8])$",
          "description": "The validity the host asks for, 1 to 398, as the form's text: a suggestion; the person chooses."
        },
        "expires": {
          "type": "string",
          "description": "RFC 3339 UTC, after now and at most ten minutes ahead."
        }
      },
      "required": [
        "csr",
        "purpose",
        "expect_root",
        "redirect",
        "state",
        "recipient",
        "valid_days",
        "expires"
      ],
      "additionalProperties": false
    },
    "ThreadRow": {
      "type": "object",
      "description": "One row of threads.csv (SPEC §9.2).",
      "properties": {
        "id": {
          "type": "string"
        },
        "contact": {
          "$ref": "#/$defs/Fingerprint"
        },
        "topic": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/InstantIn"
        },
        "last_at": {
          "$ref": "#/$defs/InstantIn"
        }
      },
      "required": [
        "id",
        "contact",
        "topic",
        "created_at",
        "last_at"
      ],
      "additionalProperties": false
    }
  }
}
