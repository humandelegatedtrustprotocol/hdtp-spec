{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git filter-repo *)",
      "Bash(git filter-branch *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add .)",
      "Bash(git add --all *)",
      "Bash(gh repo delete *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker system prune *)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/no-ai-zones.json)",
      "Write(**/.claude/settings.json)",
      "Write(**/.claude/settings.local.json)",
      "Write(**/.claude/hooks/**)",
      "Write(**/.claude/no-ai-zones.json)",
      "Edit(**/.claude/skills/harness-audit/**)",
      "Write(**/.claude/skills/harness-audit/**)"
    ],
    "ask": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(gh release create *)",
      "Bash(wrangler secret put *)",
      "Bash(npx wrangler secret put *)"
    ],
    "allow": [
      "Bash(gh pr create)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-ai-zones.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
